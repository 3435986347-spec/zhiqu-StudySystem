<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhiqu</groupId><artifactId>pdf-parser-eval</artifactId><version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>opendataloader-runner</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.zhiqu</groupId><artifactId>pdf-parser-eval-common</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opendataloader</groupId><artifactId>opendataloader-pdf-core</artifactId><version>2.4.7</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope>
        </dependency>
    </dependencies>
    <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
            <finalName>opendataloader-runner-all</finalName><createDependencyReducedPom>false</createDependencyReducedPom>
            <filters><filter><artifact>*:*</artifact><excludes>
                <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
            </excludes></filter></filters>
            <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                <mainClass>com.zhiqu.pdfeval.odl.OpenDataLoaderRunnerMain</mainClass>
            </transformer></transformers>
        </configuration></execution></executions>
    </plugin></plugins></build>
</project>
